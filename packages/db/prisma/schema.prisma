// مخطط قاعدة بيانات غصن — النسخة الأولى (المرحلة 0)
// كل مبلغ يُحفظ بعملته الأصلية + ما يعادله بالدولار (عملة الأساس)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- المستخدمون والأدوار ----------
// الجداول User/Session/Account/Verification بالشكل الذي يتوقعه Better Auth
// (مع إضافات phone-number وadmin). لا تُعدَّل أسماء حقولها دون مراجعة إعداد Better Auth.

enum Role {
  OWNER // المالك (باسل)
  MANAGER // المديرة
  STAFF // موظفة / كاشير
}

model User {
  id                  String    @id @default(cuid())
  name                String
  // Better Auth يشترط بريداً؛ لمن ليس لديها بريد يُولَّد بريد داخلي من رقم الهاتف
  email               String    @unique
  emailVerified       Boolean   @default(false)
  image               String?
  // رقم الهاتف بصيغة دولية موحدة E.164 (مثل +249912345678) — هو اسم الدخول
  phoneNumber         String?   @unique
  phoneNumberVerified Boolean   @default(false)
  role                Role      @default(STAFF)
  // إيقاف الحساب (بدل الحذف) — من إضافة admin
  banned              Boolean   @default(false)
  banReason           String?
  banExpires          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions           Session[]
  accounts           Account[]
  ratesEntered       ExchangeRate[]
  productsCreated    Product[]
  supplierEntries    SupplierLedgerEntry[]   @relation("entryCreatedBy")
  supplierVoids      SupplierLedgerEntry[]   @relation("entryVoidedBy")
  shipments          Shipment[]              @relation("shipmentCreatedBy")
  shipmentCosts      ShipmentCost[]          @relation("costCreatedBy")
  shipmentVoids      ShipmentCost[]          @relation("costVoidedBy")
  shipmentsReceived  Shipment[]              @relation("shipmentReceivedBy")
  stockMovements     StockMovement[]         @relation("stockMovementBy")
  priceHistories     PriceHistory[]
  shifts             Shift[]
  sales              Sale[]                  @relation("saleCashier")
  salesApproved      Sale[]                  @relation("saleApprovedBy")
  returns            SaleReturn[]            @relation("returnCashier")
  salesReviewed      Sale[]                  @relation("saleReviewedBy")
  expenses           Expense[]               @relation("expenseCreatedBy")
  expensesVoided     Expense[]               @relation("expenseVoidedBy")
  capitalEntries     CapitalContribution[]
  transfersCreated   WalletTransfer[]        @relation("transferCreatedBy")
  transfersVoided    WalletTransfer[]        @relation("transferVoidedBy")
  adjustmentsMade    WalletAdjustment[]      @relation("adjustmentCreatedBy")
  adjustmentsVoided  WalletAdjustment[]      @relation("adjustmentVoidedBy")
  orderStatusBy      OrderStatusHistory[]    @relation("orderStatusBy")
  orderPaymentsBy    OrderPayment[]          @relation("orderPaymentBy")
  proofsReviewed     PaymentProof[]          @relation("proofReviewedBy")
  returnsApproved    SaleReturn[]            @relation("returnApprovedBy")
  giftPhotos         GiftPhoto[]             @relation("giftPhotoBy")
  notifications      NotificationRecipient[]
  ordersOpened       Order[]                 @relation("orderOpenedBy")
  pushSubscriptions  PushSubscription[]
  notificationPrefs  NotificationPreference?
  stockAdjustments   StockAdjustment[]       @relation("adjustmentRequestedBy")
  adjustmentsDecided StockAdjustment[]       @relation("adjustmentDecidedBy")
  stockCountsMade    StockCount[]            @relation("countCreatedBy")
  stockCountsSent    StockCount[]            @relation("countSubmittedBy")
  stockCountsDecided StockCount[]            @relation("countDecidedBy")
  stockCountLines    StockCountLine[]        @relation("countLineBy")
  orderMessagesSent  OrderMessageLog[]
  auditEvents        AuditEvent[]            @relation("auditActor")
}

model Session {
  id             String   @id @default(cuid())
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

// طريقة الدخول؛ كلمة السر المشفّرة في providerId = "credential"
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------- العملات وأسعار الصرف ----------
model Currency {
  code     String  @id // SDG, USD, QAR, CNY, EGP
  nameAr   String
  nameEn   String
  symbol   String
  decimals Int     @default(2)
  isBase   Boolean @default(false) // الدولار = true
  isActive Boolean @default(true)

  ratesFrom ExchangeRate[] @relation("rateFrom")
  wallets   Wallet[]
  suppliers Supplier[]
}

enum RateSource {
  PARALLEL_MARKET // السوق الموازي
  BANK // سعر البنك
  ACTUAL_TRANSFER // من تحويل فعلي
  FIXED_PEG // سعر ثابت (الريال القطري)
}

// سعر الصرف: كم وحدة من العملة = 1 دولار
model ExchangeRate {
  id           String          @id @default(cuid())
  currency     Currency        @relation("rateFrom", fields: [currencyCode], references: [code])
  currencyCode String
  unitsPerUsd  Decimal         @db.Decimal(18, 6) // مثال: SDG 2500.000000
  source       RateSource      @default(PARALLEL_MARKET)
  effectiveAt  DateTime        @default(now())
  note         String?
  enteredBy    User?           @relation(fields: [enteredById], references: [id])
  enteredById  String?
  createdAt    DateTime        @default(now())
  transfer     WalletTransfer?

  @@index([currencyCode, effectiveAt])
}

// ---------- المحافظ (أماكن المال) ----------
model Wallet {
  id           String   @id @default(cuid())
  name         String // صندوق المحل، بنكك، حساب باسل – قطر
  currency     Currency @relation(fields: [currencyCode], references: [code])
  currencyCode String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  supplierPayments SupplierLedgerEntry[]
  shipmentCosts    ShipmentCost[]
  salePayments     SalePayment[]
  returnRefunds    ReturnRefund[]
  expenses         Expense[]
  capitalEntries   CapitalContribution[]
  transfersOut     WalletTransfer[]      @relation("transferFrom")
  transfersIn      WalletTransfer[]      @relation("transferTo")
  adjustments      WalletAdjustment[]
  closedShifts     Shift[]
  orderPayments    OrderPayment[]
}

// تحويل بين محفظتين (D-86): الخارج شامل العمولة، والواصل. لكل طرف سعره وقيمته بالدولار
// (تُحسب مرة واحدة). السعر الفعلي لعملة غير ثابتة يُسجَّل في ExchangeRate (ACTUAL_TRANSFER).
model WalletTransfer {
  id               String        @id @default(cuid())
  number           String        @unique // TRF-2026-0001
  fromWallet       Wallet        @relation("transferFrom", fields: [fromWalletId], references: [id])
  fromWalletId     String
  fromAmount       Decimal       @db.Decimal(18, 2)
  fromCurrencyCode String
  fromRate         Decimal       @db.Decimal(18, 6)
  fromAmountUsd    Decimal       @db.Decimal(18, 2)
  toWallet         Wallet        @relation("transferTo", fields: [toWalletId], references: [id])
  toWalletId       String
  toAmount         Decimal       @db.Decimal(18, 2)
  toCurrencyCode   String
  toRate           Decimal       @db.Decimal(18, 6)
  toAmountUsd      Decimal       @db.Decimal(18, 2)
  // العمولة بعملة المحفظة الخارجة — للمعلومة، وهي ضمن fromAmount
  feeAmount        Decimal?      @db.Decimal(18, 2)
  rate             ExchangeRate? @relation(fields: [rateId], references: [id])
  rateId           String?       @unique
  occurredAt       DateTime
  reference        String?
  note             String?
  createdBy        User?         @relation("transferCreatedBy", fields: [createdById], references: [id])
  createdById      String?
  createdAt        DateTime      @default(now())
  voidedAt         DateTime?
  voidedBy         User?         @relation("transferVoidedBy", fields: [voidedById], references: [id])
  voidedById       String?
  voidReason       String?

  @@index([fromWalletId, occurredAt])
  @@index([toWalletId, occurredAt])
}

enum WalletAdjustmentKind {
  OPENING // رصيد افتتاحي (جرد): الرصيد الفعلي في لحظته — ما قبلها لا يُحسب
  MANUAL // تسوية يدوية بسبب مكتوب (المالك)
}

// تسوية رصيد محفظة بإشارة (D-86). لا تُعدَّل — تُلغى بسبب
model WalletAdjustment {
  id           String               @id @default(cuid())
  wallet       Wallet               @relation(fields: [walletId], references: [id])
  walletId     String
  kind         WalletAdjustmentKind
  amount       Decimal              @db.Decimal(18, 2)
  currencyCode String
  rateUsed     Decimal              @db.Decimal(18, 6)
  amountUsd    Decimal              @db.Decimal(18, 2)
  occurredAt   DateTime
  reason       String
  createdBy    User?                @relation("adjustmentCreatedBy", fields: [createdById], references: [id])
  createdById  String?
  createdAt    DateTime             @default(now())
  voidedAt     DateTime?
  voidedBy     User?                @relation("adjustmentVoidedBy", fields: [voidedById], references: [id])
  voidedById   String?
  voidReason   String?

  @@index([walletId, occurredAt])
}

// ---------- الأقسام ----------
model Category {
  id           String  @id @default(cuid())
  slug         String  @unique
  nameAr       String
  nameEn       String
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)
  // هامش الربح المستهدف والحد الأدنى للتنبيه (نسبة من سعر البيع)
  targetMargin Decimal @default(0.40) @db.Decimal(5, 4)
  minMargin    Decimal @default(0.35) @db.Decimal(5, 4)

  products    Product[]
  stockCounts StockCount[]
}

// ---------- المنتجات ----------
enum ProductType {
  STOCK // بضاعة للبيع
  MATERIAL // مادة تغليف داخلية — لا تُباع ولا تظهر في المتجر
}

enum StockUnit {
  PIECE // حبة
  METER // متر (شرائط)
  SHEET // ورقة / فرخ
}

model Product {
  id            String      @id @default(cuid())
  nameAr        String
  nameEn        String?
  descriptionAr String?
  descriptionEn String?
  category      Category    @relation(fields: [categoryId], references: [id])
  categoryId    String
  type          ProductType @default(STOCK)
  unit          StockUnit   @default(PIECE)
  // تتبّع تاريخ الصلاحية للدفعات (عطور وتجميل — FEFO)
  trackExpiry   Boolean     @default(false)
  isActive      Boolean     @default(true)
  // يظهر في المتجر الإلكتروني (البضاعة فقط)
  isWebVisible  Boolean     @default(false)
  // تجاوز هوامش القسم لهذا المنتج (فارغ = هامش القسم)
  targetMargin  Decimal?    @db.Decimal(5, 4)
  minMargin     Decimal?    @db.Decimal(5, 4)
  // نص البحث الموحّد (normalizeArabic): الأسماء + SKU + الباركودات + القسم
  // حد تنبيه «قارب على النفاد» لهذا المنتج؛ فارغ = الحد العام من الضبط (D-94)
  lowStockQty   Decimal?    @db.Decimal(12, 3)
  searchText    String      @default("")
  createdBy     User?       @relation(fields: [createdById], references: [id])
  createdById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  variants  ProductVariant[]
  images    ProductImage[]
  occasions ProductOccasion[]

  @@index([categoryId])
  @@index([deletedAt])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

// المتغيّر = وحدة البيع والمخزون والباركود (مقاس / لون / حجم)
model ProductVariant {
  id        String    @id @default(cuid())
  product   Product   @relation(fields: [productId], references: [id])
  productId String
  sku       String    @unique
  barcode   String    @unique
  size      String? // المقاس
  color     String? // اللون
  volume    String? // الحجم (50ml)
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  // سعر البيع بالجنيه — يتغير فقط بموافقة ويُسجَّل في PriceHistory (D-24)
  priceSdg  Decimal?  @db.Decimal(18, 2)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  shipmentLines  ShipmentLine[]
  orderLines     OrderLine[]
  priceHistory   PriceHistory[]
  saleLines      SaleLine[]
  stockLevel     StockLevel?
  stockBatches   StockBatch[]
  stockMovements StockMovement[]
  adjustments    StockAdjustment[]
  countLines     StockCountLine[]
  wrapMaterials  WrapStyleMaterial[]

  @@index([productId])
}

// صورة منتج: ملفات WebP في التخزين (محلياً uploads، وR2 عند النشر). الأولى حسب sortOrder هي الرئيسية
model ProductImage {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  // مفتاح التخزين الأساسي؛ الملفات: {key}-1200.webp و {key}-400.webp
  key       String   @unique
  width     Int
  height    Int
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

// ---------- الموردون وحساباتهم (D-74، D-75) ----------
model Supplier {
  id           String    @id @default(cuid())
  name         String
  // رمز الدولة ISO (SD، QA، CN، EG، SA، AE…)
  country      String
  // عملة حساب المورد — ثابتة بعد أول حركة
  currency     Currency  @relation(fields: [currencyCode], references: [code])
  currencyCode String
  phone        String?
  notes        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  entries   SupplierLedgerEntry[]
  shipments Shipment[]
}

enum SupplierEntryKind {
  OPENING_BALANCE // رصيد افتتاحي (دين قائم قبل النظام)
  PURCHASE // شحنة مشتراة (تُضاف مع الشحنات)
  PAYMENT // دفعة للمورد من محفظة
}

// حركة في حساب المورد. لا تُعدَّل ولا تُحذف — الخطأ يُلغى (voidedAt) مع السبب
model SupplierLedgerEntry {
  id           String            @id @default(cuid())
  supplier     Supplier          @relation(fields: [supplierId], references: [id])
  supplierId   String
  kind         SupplierEntryKind
  occurredAt   DateTime
  // بعملة المورد وبإشارة: موجب = علينا للمورد، سالب = لنا (دفعة أو عربون)
  amount       Decimal           @db.Decimal(18, 2)
  currencyCode String
  // وحدات عملة المورد لكل 1$ لحظة الحركة (للدفعة بعملة أخرى: السعر الضمني)
  rateUsed     Decimal           @db.Decimal(18, 6)
  // بالدولار وبنفس الإشارة — يُحسب مرة واحدة عند الكتابة (D-21)
  amountUsd    Decimal           @db.Decimal(18, 2)

  // الدفعة: ما خرج فعلاً من المحفظة (قد تكون عملتها غير عملة المورد)
  wallet           Wallet?  @relation(fields: [walletId], references: [id])
  walletId         String?
  paidAmount       Decimal? @db.Decimal(18, 2)
  paidCurrencyCode String?
  paidRate         Decimal? @db.Decimal(18, 6)
  reference        String? // رقم التحويل أو الإيصال

  dueDate DateTime? // تاريخ استحقاق (للشراء بالأقساط)
  note    String?

  // حركة الشراء مربوطة بشحنتها
  shipment   Shipment? @relation(fields: [shipmentId], references: [id])
  shipmentId String?

  createdBy   User?     @relation("entryCreatedBy", fields: [createdById], references: [id])
  createdById String?
  createdAt   DateTime  @default(now())
  voidedAt    DateTime?
  voidedBy    User?     @relation("entryVoidedBy", fields: [voidedById], references: [id])
  voidedById  String?
  voidReason  String?

  @@index([supplierId, occurredAt])
}

// ---------- الشحنات والتكلفة الواصلة (D-77) ----------
enum ShipmentStatus {
  DRAFT // مسودة — لا تؤثر على حساب المورد
  PURCHASED // مشتراة — مسجّلة في حساب المورد
  IN_TRANSIT // في الطريق
  IN_CUSTOMS // في الجمارك
  ARRIVED // وصلت
  RECEIVED // مستلمة (مغلقة — الخطوة 5)
  CANCELLED // ملغاة
}

model Shipment {
  id           String         @id @default(cuid())
  // رقم مقروء: SHP-2026-001
  number       String         @unique
  supplier     Supplier       @relation(fields: [supplierId], references: [id])
  supplierId   String
  // بلد المصدر (ISO) — افتراضياً بلد المورد
  origin       String
  status       ShipmentStatus @default(DRAFT)
  // تاريخ الشراء — سعر صرفه يحدد تكلفة البضاعة (D-75)
  purchasedAt  DateTime
  currencyCode String
  // سعر صرف عملة المورد يوم الشراء (يُثبَّت عند التأكيد)
  rateUsed     Decimal?       @db.Decimal(18, 6)
  dueDate      DateTime?
  notes        String?
  createdBy    User?          @relation("shipmentCreatedBy", fields: [createdById], references: [id])
  createdById  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  // الاستلام (D-78): مرة واحدة ويغلق الشحنة
  receivedAt   DateTime?
  receivedBy   User?          @relation("shipmentReceivedBy", fields: [receivedById], references: [id])
  receivedById String?

  lines          ShipmentLine[]
  costs          ShipmentCost[]
  ledgerEntries  SupplierLedgerEntry[]
  stockMovements StockMovement[]

  @@index([status])
  @@index([supplierId])
}

model ShipmentLine {
  id          String         @id @default(cuid())
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId  String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  variantId   String
  // كسور للمواد (متر شريط)؛ الحبة عدد صحيح
  qty         Decimal        @db.Decimal(12, 3)
  // سعر الوحدة بعملة المورد
  unitPrice   Decimal        @db.Decimal(18, 4)
  sortOrder   Int            @default(0)
  // عند الاستلام: السليم والتالف (الباقي = ناقص)، وخسارة البند إن لم يصل منه شيء سليم
  receivedQty Decimal?       @db.Decimal(12, 3)
  damagedQty  Decimal?       @db.Decimal(12, 3)
  lossUsd     Decimal?       @db.Decimal(18, 2)
  batch       StockBatch?

  @@index([shipmentId])
}

enum ShipmentCostKind {
  SHIPPING // شحن
  CUSTOMS // جمارك
  CLEARANCE // تخليص
  TRANSPORT // نقل داخلي
  COMMISSION // عمولة
  OTHER // أخرى
}

// تكلفة إضافية للشحنة — تُدفع من محفظة بعملتها وسعر يوم دفعها. لا تُحذف؛ تُلغى مع السبب
model ShipmentCost {
  id           String           @id @default(cuid())
  shipment     Shipment         @relation(fields: [shipmentId], references: [id])
  shipmentId   String
  kind         ShipmentCostKind
  amount       Decimal          @db.Decimal(18, 2)
  currencyCode String
  rateUsed     Decimal          @db.Decimal(18, 6)
  amountUsd    Decimal          @db.Decimal(18, 2)
  wallet       Wallet           @relation(fields: [walletId], references: [id])
  walletId     String
  paidAt       DateTime
  note         String?
  createdBy    User?            @relation("costCreatedBy", fields: [createdById], references: [id])
  createdById  String?
  createdAt    DateTime         @default(now())
  voidedAt     DateTime?
  voidedBy     User?            @relation("costVoidedBy", fields: [voidedById], references: [id])
  voidedById   String?
  voidReason   String?

  stockMovements StockMovement[]

  @@index([shipmentId])
}

// عدّاد أرقام المستندات حسب النوع والسنة (SHP-2026، GHS-2026…)
model DocumentCounter {
  key   String @id
  value Int
}

// ---------- المخزون (D-78) ----------
// الرصيد الحالي لكل متغيّر ومتوسط تكلفته المرجّح بالدولار — يُحدَّث في نفس معاملة الحركة
model StockLevel {
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  variantId  String         @id
  qty        Decimal        @default(0) @db.Decimal(12, 3)
  avgCostUsd Decimal        @default(0) @db.Decimal(18, 6)
  updatedAt  DateTime       @updatedAt
}

// دفعة = ما دخل المخزون من بند شحنة، بتكلفة واصلة ثابتة (تتغير فقط بفاتورة متأخرة)
model StockBatch {
  id             String         @id @default(cuid())
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  variantId      String
  shipmentLine   ShipmentLine?  @relation(fields: [shipmentLineId], references: [id])
  shipmentLineId String?        @unique
  qtyReceived    Decimal        @db.Decimal(12, 3)
  // يُنقص بالبيع لاحقاً (FEFO للأصناف ذات الصلاحية)
  qtyRemaining   Decimal        @db.Decimal(12, 3)
  landedUnitUsd  Decimal        @db.Decimal(18, 6)
  expiresAt      DateTime?      @db.Date
  receivedAt     DateTime
  createdAt      DateTime       @default(now())

  movements StockMovement[]

  @@index([variantId, expiresAt])
}

enum StockMovementKind {
  RECEIPT // استلام شحنة
  REVALUATION // تكلفة متأخرة أو إلغاؤها بعد الاستلام (الكمية صفر)
  SALE // بيع (كمية سالبة)
  RETURN // مرتجع سليم يعود للمخزون
  CONSUMPTION // مواد تغليف استُهلكت في تجهيز طلب (كمية سالبة)
  ADJUSTMENT // تسوية معتمدة: تالف، مفقود، زيادة، فرق جرد (D-111)
}

// دفتر حركات المخزون — لا يُعدَّل ولا يُحذف (system-design §4.3)
model StockMovement {
  id              String            @id @default(cuid())
  variant         ProductVariant    @relation(fields: [variantId], references: [id])
  variantId       String
  batch           StockBatch?       @relation(fields: [batchId], references: [id])
  batchId         String?
  kind            StockMovementKind
  qty             Decimal           @db.Decimal(12, 3)
  unitCostUsd     Decimal?          @db.Decimal(18, 6)
  // التغير في قيمة المخزون بالدولار
  valueUsd        Decimal           @db.Decimal(18, 2)
  // ما يخص وحدات خرجت أو لم تصل ← مصروف (تسوية تكلفة المبيعات)
  expenseUsd      Decimal           @default(0) @db.Decimal(18, 2)
  qtyAfter        Decimal           @db.Decimal(12, 3)
  avgCostAfterUsd Decimal           @db.Decimal(18, 6)
  shipment        Shipment?         @relation(fields: [shipmentId], references: [id])
  shipmentId      String?
  shipmentCost    ShipmentCost?     @relation(fields: [shipmentCostId], references: [id])
  shipmentCostId  String?
  sale            Sale?             @relation(fields: [saleId], references: [id])
  saleId          String?
  saleReturn      SaleReturn?       @relation(fields: [saleReturnId], references: [id])
  saleReturnId    String?
  order           Order?            @relation(fields: [orderId], references: [id])
  orderId         String?
  adjustment      StockAdjustment?  @relation(fields: [adjustmentId], references: [id])
  adjustmentId    String?
  // بيع تجاوز الرصيد (سالب) بموافقة — CLAUDE.md §6.8
  override        Boolean           @default(false)
  note            String?
  createdBy       User?             @relation("stockMovementBy", fields: [createdById], references: [id])
  createdById     String?
  createdAt       DateTime          @default(now())

  @@index([variantId, createdAt])
  @@index([shipmentId])
  @@index([saleId])
  @@index([orderId])
  @@index([adjustmentId])
}

// ---------- تسويات المخزون (D-111) ----------
enum StockAdjustmentReason {
  DAMAGED // تالف في المحل
  EXPIRED // منتهي الصلاحية
  LOST // مفقود / عجز
  INTERNAL_USE // استخدام داخلي، عيّنة، تستر
  FOUND // زيادة وُجدت
  COUNT // فرق جرد
}

enum StockAdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

// تسوية لصنف واحد: تُسجَّل ثم تُعتمد (المديرة حتى الحد، والمالك بلا حد). لا يتغير الرصيد قبل
// الاعتماد، ولا تُحذف — الخطأ يُصحَّح بتسوية عكسية
model StockAdjustment {
  id            String                @id @default(cuid())
  number        String                @unique
  variant       ProductVariant        @relation(fields: [variantId], references: [id])
  variantId     String
  reason        StockAdjustmentReason
  // موقّعة: سالبة = خروج من المخزون
  qty           Decimal               @db.Decimal(12, 3)
  note          String?
  // صورة اختيارية (تالف) — تخزين خاص
  photoKey      String?
  status        StockAdjustmentStatus @default(PENDING)
  // تُثبَّت عند الاعتماد: تكلفة الوحدة والتغير في قيمة المخزون (موقّع)
  unitCostUsd   Decimal?              @db.Decimal(18, 6)
  valueUsd      Decimal?              @db.Decimal(18, 2)
  // التكلفة أدخلها المعتمِد (صنف بلا تكلفة)
  costEntered   Boolean               @default(false)
  requestedBy   User                  @relation("adjustmentRequestedBy", fields: [requestedById], references: [id])
  requestedById String
  createdAt     DateTime              @default(now())
  decidedBy     User?                 @relation("adjustmentDecidedBy", fields: [decidedById], references: [id])
  decidedById   String?
  decidedAt     DateTime?
  rejectReason  String?
  // فرق جرد: من أي جرد جاءت
  count         StockCount?           @relation(fields: [countId], references: [id])
  countId       String?

  movements StockMovement[]
  countLine StockCountLine?

  @@index([status, createdAt])
  @@index([variantId, createdAt])
  @@index([decidedAt])
}

// ---------- الجرد (D-112) ----------
enum StockCountScope {
  FULL // المحل كله
  CATEGORY // قسم واحد
  QUICK // عدّ سريع: الرصيد السالب والأغلى تكلفة
}

enum StockCountStatus {
  OPEN // العد جارٍ
  SUBMITTED // أُرسل للمراجعة
  APPROVED
  CANCELLED
}

// جرد: قائمة أصناف تُعدّ بالمسح (عدّ أعمى)، ثم تُراجع فروقاتها وتُعتمد كتسويات «فرق جرد»
model StockCount {
  id            String           @id @default(cuid())
  number        String           @unique
  scope         StockCountScope
  category      Category?        @relation(fields: [categoryId], references: [id])
  categoryId    String?
  status        StockCountStatus @default(OPEN)
  createdBy     User             @relation("countCreatedBy", fields: [createdById], references: [id])
  createdById   String
  createdAt     DateTime         @default(now())
  submittedBy   User?            @relation("countSubmittedBy", fields: [submittedById], references: [id])
  submittedById String?
  submittedAt   DateTime?
  decidedBy     User?            @relation("countDecidedBy", fields: [decidedById], references: [id])
  decidedById   String?
  decidedAt     DateTime?
  cancelReason  String?

  lines       StockCountLine[]
  adjustments StockAdjustment[]

  @@index([status, createdAt])
}

enum StockCountLineStatus {
  PENDING // لم يُعدّ
  COUNTED
  MISSING // غير موجود على الرف (العدد صفر)
  RECOUNT // طلبت المراجِعة إعادة عدّه
}

// صنف في جرد: رصيد النظام يُلتقط لحظة عدّه — فما يُباع قبلها أو بعدها لا يفسد الفرق
model StockCountLine {
  id           String               @id @default(cuid())
  count        StockCount           @relation(fields: [countId], references: [id])
  countId      String
  variant      ProductVariant       @relation(fields: [variantId], references: [id])
  variantId    String
  status       StockCountLineStatus @default(PENDING)
  countedQty   Decimal?             @db.Decimal(12, 3)
  // رصيد النظام لحظة العد (لا يُعرض لمن تعدّ)
  systemQty    Decimal?             @db.Decimal(12, 3)
  countedBy    User?                @relation("countLineBy", fields: [countedById], references: [id])
  countedById  String?
  countedAt    DateTime?
  // التسوية التي نتجت عند الاعتماد (للفرق غير الصفري)
  adjustment   StockAdjustment?     @relation(fields: [adjustmentId], references: [id])
  adjustmentId String?              @unique

  @@unique([countId, variantId])
  @@index([countId, status])
}

// ---------- التسعير (D-24، D-79) ----------
enum PriceChangeReason {
  INITIAL // أول سعر
  REVIEW_UP // مراجعة: هامش تحت الحد الأدنى
  REVIEW_DOWN // مراجعة: هامش أعلى بكثير من المستهدف
  MANUAL // تعديل يدوي
}

// سجل الأسعار — لا يُعدَّل ولا يُحذف
model PriceHistory {
  id           String            @id @default(cuid())
  variant      ProductVariant    @relation(fields: [variantId], references: [id])
  variantId    String
  oldPriceSdg  Decimal?          @db.Decimal(18, 2)
  newPriceSdg  Decimal           @db.Decimal(18, 2)
  // سعر الصرف ومتوسط التكلفة والهامش لحظة الموافقة
  sdgPerUsd    Decimal           @db.Decimal(18, 6)
  avgCostUsd   Decimal           @db.Decimal(18, 6)
  margin       Decimal?          @db.Decimal(9, 6)
  reason       PriceChangeReason
  note         String?
  approvedBy   User              @relation(fields: [approvedById], references: [id])
  approvedById String
  createdAt    DateTime          @default(now())

  @@index([variantId, createdAt])
}

// ---------- نقطة البيع (D-80) ----------
// إعدادات عامة بمفتاح: pos (حد الخصم، مدة المرتجع)، receipt (نصوص الإيصال)
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// العميل: رقم الهاتف E.164 هو المعرّف (system-design §4.6)
model Customer {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String?
  createdAt DateTime @default(now())

  sales  Sale[]
  orders Order[]
}

// وردية موظفة: عهدة نقدية افتتاحية ← إغلاق بعدّ النقد ومطابقته
model Shift {
  id              String    @id @default(cuid())
  user            User      @relation(fields: [userId], references: [id])
  userId          String
  openedAt        DateTime  @default(now())
  openingCashSdg  Decimal   @db.Decimal(18, 2)
  closedAt        DateTime?
  expectedCashSdg Decimal?  @db.Decimal(18, 2)
  countedCashSdg  Decimal?  @db.Decimal(18, 2)
  closeNote       String?
  // محفظة النقد عند الإغلاق: فرق العدّ (المعدود − المتوقع) يُسوّى في رصيدها (D-86)
  cashWallet      Wallet?   @relation(fields: [cashWalletId], references: [id])
  cashWalletId    String?
  // فرق العدّ بالدولار بسعر الجنيه لحظة الإغلاق — يدخل ربح الشهر (D-87)
  closeSdgPerUsd  Decimal?  @db.Decimal(18, 6)
  differenceUsd   Decimal?  @db.Decimal(18, 2)

  sales         Sale[]
  returns       SaleReturn[]
  expenses      Expense[]
  orderPayments OrderPayment[]

  @@index([userId, closedAt])
  @@index([closedAt])
}

// فاتورة بيع في المحل — INV-2026-000001. المعرّف يُولَّد على الجهاز (D-61) فيكون الحفظ متكرراً بأمان
model Sale {
  id                 String    @id
  number             String    @unique
  shift              Shift     @relation(fields: [shiftId], references: [id])
  shiftId            String
  cashier            User      @relation("saleCashier", fields: [cashierId], references: [id])
  cashierId          String
  customer           Customer? @relation(fields: [customerId], references: [id])
  customerId         String?
  subtotalSdg        Decimal   @db.Decimal(18, 2)
  lineDiscountSdg    Decimal   @db.Decimal(18, 2)
  invoiceDiscountSdg Decimal   @db.Decimal(18, 2)
  totalSdg           Decimal   @db.Decimal(18, 2)
  // سعر الجنيه لحظة البيع والإيراد والتكلفة بالدولار (currency-and-costing §6)
  sdgPerUsd          Decimal   @db.Decimal(18, 6)
  revenueUsd         Decimal   @db.Decimal(18, 2)
  cogsUsd            Decimal   @db.Decimal(18, 2)
  cashTenderedSdg    Decimal?  @db.Decimal(18, 2)
  changeSdg          Decimal   @default(0) @db.Decimal(18, 2)
  // خصم فوق الحد أو تحت التكلفة أو تجاوز رصيد: من وافق
  approvedBy         User?     @relation("saleApprovedBy", fields: [approvedById], references: [id])
  approvedById       String?
  note               String?
  // بيع دون اتصال (D-82): رقم الجهاز المؤقت، وملاحظات تحتاج مراجعة المديرة
  offline            Boolean   @default(false)
  localNumber        String?   @unique
  syncedAt           DateTime?
  reviewNote         String?
  reviewedAt         DateTime?
  reviewedBy         User?     @relation("saleReviewedBy", fields: [reviewedById], references: [id])
  reviewedById       String?
  createdAt          DateTime  @default(now())

  lines          SaleLine[]
  returns        SaleReturn[]
  payments       SalePayment[]
  stockMovements StockMovement[]

  @@index([shiftId])
  @@index([createdAt])
  @@index([customerId])
}

model SaleLine {
  id                 String           @id @default(cuid())
  sale               Sale             @relation(fields: [saleId], references: [id])
  saleId             String
  variant            ProductVariant   @relation(fields: [variantId], references: [id])
  variantId          String
  // اسم الصنف وقت البيع (للإيصال حتى لو تغيّر الاسم لاحقاً)
  label              String
  qty                Decimal          @db.Decimal(12, 3)
  unitPriceSdg       Decimal          @db.Decimal(18, 2)
  lineDiscountSdg    Decimal          @db.Decimal(18, 2)
  invoiceDiscountSdg Decimal          @db.Decimal(18, 2)
  netSdg             Decimal          @db.Decimal(18, 2)
  // متوسط التكلفة لحظة البيع (D-26)
  unitCostUsd        Decimal          @db.Decimal(18, 6)
  costUsd            Decimal          @db.Decimal(18, 2)
  sortOrder          Int              @default(0)
  returnLines        SaleReturnLine[]

  @@index([saleId])
  @@index([variantId])
}

enum PaymentMethod {
  CASH
  BANKAK
  CREDIT // رصيد استبدال من مرتجع (D-81)
}

model SalePayment {
  id           String        @id @default(cuid())
  sale         Sale          @relation(fields: [saleId], references: [id])
  saleId       String
  method       PaymentMethod
  amountSdg    Decimal       @db.Decimal(18, 2)
  wallet       Wallet?       @relation(fields: [walletId], references: [id])
  walletId     String?
  // رقم عملية بنكك (اختياري)
  reference    String?
  // لطريقة CREDIT: المرتجع الذي جاء منه الرصيد
  saleReturn   SaleReturn?   @relation(fields: [saleReturnId], references: [id])
  saleReturnId String?

  @@index([saleId])
}

// ---------- المرتجعات والاستبدال (D-81) ----------
// مرتجع مرتبط بفاتورة البيع — RET-2026-000001. المعرّف من الجهاز (D-61)
model SaleReturn {
  id             String   @id
  number         String   @unique
  sale           Sale     @relation(fields: [saleId], references: [id])
  saleId         String
  shift          Shift    @relation(fields: [shiftId], references: [id])
  shiftId        String
  cashier        User     @relation("returnCashier", fields: [cashierId], references: [id])
  cashierId      String
  // بعد مدة المرتجع يحتاج موافقة
  approvedBy     User?    @relation("returnApprovedBy", fields: [approvedById], references: [id])
  approvedById   String?
  reason         String?
  // المسترد بالسعر الفعلي بعد الخصم، وما يعادله بالدولار بسعر يوم البيع (عكس الإيراد)
  refundSdg      Decimal  @db.Decimal(18, 2)
  refundUsd      Decimal  @db.Decimal(18, 2)
  // تكلفة السليم العائد للمخزون، وتكلفة التالف (خسارة)
  restockCostUsd Decimal  @db.Decimal(18, 2)
  damagedCostUsd Decimal  @db.Decimal(18, 2)
  // استبدال: المبلغ رصيد يُستخدم في فاتورة جديدة
  isExchange     Boolean  @default(false)
  createdAt      DateTime @default(now())

  lines          SaleReturnLine[]
  refunds        ReturnRefund[]
  creditPayments SalePayment[]
  stockMovements StockMovement[]

  @@index([saleId])
  @@index([shiftId])
}

model SaleReturnLine {
  id          String     @id @default(cuid())
  saleReturn  SaleReturn @relation(fields: [returnId], references: [id])
  returnId    String
  saleLine    SaleLine   @relation(fields: [saleLineId], references: [id])
  saleLineId  String
  qty         Decimal    @db.Decimal(12, 3)
  // من الكمية: التالف لا يعود للمخزون
  damagedQty  Decimal    @db.Decimal(12, 3)
  refundSdg   Decimal    @db.Decimal(18, 2)
  unitCostUsd Decimal    @db.Decimal(18, 6)

  @@index([returnId])
  @@index([saleLineId])
}

// ما رُدّ للعميل فعلاً: نقداً من الدرج أو بنكك (والاستبدال يُرد فائضه نقداً)
model ReturnRefund {
  id         String        @id @default(cuid())
  saleReturn SaleReturn    @relation(fields: [returnId], references: [id])
  returnId   String
  method     PaymentMethod
  amountSdg  Decimal       @db.Decimal(18, 2)
  wallet     Wallet        @relation(fields: [walletId], references: [id])
  walletId   String
  reference  String?
  // فائض رصيد استبدال رُدّ عند البيع: في أي وردية خرج النقد، ومع أي فاتورة
  shiftId    String?
  saleId     String?
  createdAt  DateTime      @default(now())

  @@index([returnId])
  @@index([shiftId])
}

// ---------- المصاريف ورأس المال (D-83) ----------
// أقسام المصاريف — يضيفها المالك ويعدّلها؛ staffAllowed: تسجّلها الموظفة (حتى الحد في الضبط)
model ExpenseCategory {
  id           String    @id @default(cuid())
  name         String    @unique
  staffAllowed Boolean   @default(false)
  isActive     Boolean   @default(true)
  sortOrder    Int       @default(0)
  expenses     Expense[]
}

// مصروف من محفظة بعملتها وسعر يوم الدفع (D-21). لا يُحذف؛ يُلغى مع السبب
model Expense {
  id            String          @id @default(cuid())
  number        String          @unique
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
  categoryId    String
  amount        Decimal         @db.Decimal(18, 2)
  currencyCode  String
  rateUsed      Decimal         @db.Decimal(18, 6)
  amountUsd     Decimal         @db.Decimal(18, 2)
  wallet        Wallet          @relation(fields: [walletId], references: [id])
  walletId      String
  spentAt       DateTime
  note          String?
  // صورة الفاتورة (اختيارية) — تخزين خاص، لا تُقدَّم علناً
  attachmentKey String?
  // نقد من درج وردية مفتوحة ينقص النقد المتوقع عند الإغلاق
  shift         Shift?          @relation(fields: [shiftId], references: [id])
  shiftId       String?
  createdBy     User?           @relation("expenseCreatedBy", fields: [createdById], references: [id])
  createdById   String?
  createdAt     DateTime        @default(now())
  voidedAt      DateTime?
  voidedBy      User?           @relation("expenseVoidedBy", fields: [voidedById], references: [id])
  voidedById    String?
  voidReason    String?

  @@index([spentAt])
  @@index([shiftId])
}

// تمويل الشركاء (باسل الآن): يُسترد من الربح أولاً قبل أي توزيع (D-83)
model CapitalContribution {
  id            String    @id @default(cuid())
  partnerName   String
  amount        Decimal   @db.Decimal(18, 2)
  currencyCode  String
  rateUsed      Decimal   @db.Decimal(18, 6)
  amountUsd     Decimal   @db.Decimal(18, 2)
  contributedAt DateTime
  note          String?
  createdBy     User?     @relation(fields: [createdById], references: [id])
  createdById   String?
  createdAt     DateTime  @default(now())
  voidedAt      DateTime?
  voidReason    String?
  wallet        Wallet?   @relation(fields: [walletId], references: [id])
  walletId      String?
}

// ---------- طلبات المتجر (المرحلة 2 — D-88، customer-journey) ----------
enum OrderStatus {
  NEW
  AWAITING_PAYMENT
  PAYMENT_REVIEW
  CONFIRMED
  PREPARING
  AWAITING_PHOTO_APPROVAL
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum OrderChannel {
  WEB
  WHATSAPP
  POS
}

enum Fulfillment {
  DELIVERY // عبر شركة التوصيل (D-88)
  PICKUP // استلام من المحل
}

enum DeliveryCity {
  KHARTOUM
  BAHRI
  OMDURMAN
}

enum OrderPaymentMethod {
  COD // عند الاستلام — يحصّله مندوب شركة التوصيل
  IN_SHOP // في المحل عند الاستلام (نقداً أو بنكك)
  BANKAK // تحويل مسبق (المرحلة 2.3)
}

// الطلب: السعر بالجنيه مثبّت عند الإنشاء؛ المخزون محجوز حتى التجهيز ثم يُخصم (StockMovement)
model Order {
  id             String             @id
  number         String             @unique // GHS-2026-000001
  // رابط المتابعة للعميل (ضيف) — سرّي وعشوائي
  trackingToken  String             @unique
  channel        OrderChannel       @default(WEB)
  status         OrderStatus        @default(NEW)
  locale         String             @default("ar")
  customer       Customer           @relation(fields: [customerId], references: [id])
  customerId     String
  customerName   String
  fulfillment    Fulfillment
  city           DeliveryCity?
  address        String?
  // المستلم إن كانت هدية لشخص آخر
  recipientName  String?
  recipientPhone String?
  note           String?
  paymentMethod  OrderPaymentMethod
  subtotalSdg    Decimal            @db.Decimal(18, 2)
  totalSdg       Decimal            @db.Decimal(18, 2)
  // التكلفة عند بدء التجهيز (خروج المخزون)، والإيراد عند التسليم بسعر الجنيه لحظتها
  cogsUsd        Decimal?           @db.Decimal(18, 2)
  sdgPerUsd      Decimal?           @db.Decimal(18, 6)
  revenueUsd     Decimal?           @db.Decimal(18, 2)
  // رقم الشحنة عند شركة التوصيل
  courierRef     String?
  // بنكك: مهلة الدفع 24 ساعة من الإنشاء (D-12)؛ بعدها يُلغى الطلب تلقائياً ويُفك الحجز
  paymentDueAt   DateTime?
  preparedAt     DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  // «صمّم هديتك» (D-91): نمط التغليف وسعره مثبّتان عند الطلب، ونص البطاقة
  wrapStyle      WrapStyle?         @relation(fields: [wrapStyleId], references: [id])
  wrapStyleId    String?
  wrapName       String?
  wrapPriceSdg   Decimal?           @db.Decimal(18, 2)
  wrapCostUsd    Decimal?           @db.Decimal(18, 2)
  cardMessage    String?
  // موعد رد العميل على صورة الهدية — ميزة ملغاة (D-99)، يبقى للطلبات القديمة فقط
  photoDueAt     DateTime?
  // آخر فتح لصفحة الطلب في الإدارة (D-109): يوقف تكرار صوت التنبيه والتصعيد
  lastOpenedAt   DateTime?
  lastOpenedBy   User?              @relation("orderOpenedBy", fields: [lastOpenedById], references: [id])
  lastOpenedById String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  lines          OrderLine[]
  history        OrderStatusHistory[]
  payments       OrderPayment[]
  paymentProofs  PaymentProof[]
  giftPhotos     GiftPhoto[]
  stockMovements StockMovement[]
  notifications  Notification[]
  messages       OrderMessageLog[]

  @@index([status, createdAt])
  @@index([status, paymentDueAt])
  @@index([status, photoDueAt])
  @@index([deliveredAt])
  @@index([customerId])
}

enum OrderMessageChannel {
  MANUAL // زر wa.me من صفحة الطلب (قبل ربط Cloud API)
  API // WhatsApp Cloud API (المرحلة 3)
}

// سجل رسائل واتساب للطلب (D-113): أي رسالة، ومن أرسلها، ومتى. اليدوي يسجّل فتح الرسالة في واتساب
model OrderMessageLog {
  id        String              @id @default(cuid())
  order     Order               @relation(fields: [orderId], references: [id])
  orderId   String
  // مفتاح القالب (RECEIVED، OUT_FOR_DELIVERY…) — نفس المفاتيح في @ghusn/core
  key       String
  channel   OrderMessageChannel @default(MANUAL)
  sentBy    User?               @relation(fields: [sentById], references: [id])
  sentById  String?
  createdAt DateTime            @default(now())

  @@index([orderId, createdAt])
}

model OrderLine {
  id           String         @id @default(cuid())
  order        Order          @relation(fields: [orderId], references: [id])
  orderId      String
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  variantId    String
  // الاسم وقت الطلب (لا يتغير لو عُدّل المنتج لاحقاً)
  label        String
  qty          Decimal        @db.Decimal(12, 3)
  unitPriceSdg Decimal        @db.Decimal(18, 2)
  lineTotalSdg Decimal        @db.Decimal(18, 2)
  // عند التجهيز: متوسط التكلفة ساعتها
  unitCostUsd  Decimal?       @db.Decimal(18, 6)
  sortOrder    Int            @default(0)

  @@index([orderId])
  @@index([variantId])
}

// سجل الحالات: من، إلى، متى، من الموظفة، ولماذا (customer-journey §2)
model OrderStatusHistory {
  id         String       @id @default(cuid())
  order      Order        @relation(fields: [orderId], references: [id])
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actor      User?        @relation("orderStatusBy", fields: [actorId], references: [id])
  actorId    String?
  reason     String?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
}

// المقبوض عن الطلب إلى محفظة: عند الاستلام ← محفظة شركة التوصيل؛ في المحل ← الصندوق مع الوردية أو بنكك
model OrderPayment {
  id           String             @id @default(cuid())
  order        Order              @relation(fields: [orderId], references: [id])
  orderId      String
  method       OrderPaymentMethod
  // في المحل: نقداً أو بنكك
  channel      PaymentMethod?
  amountSdg    Decimal            @db.Decimal(18, 2)
  wallet       Wallet             @relation(fields: [walletId], references: [id])
  walletId     String
  // نقد المحل يدخل درج الوردية (يدخل النقد المتوقع عند الإغلاق)
  shift        Shift?             @relation(fields: [shiftId], references: [id])
  shiftId      String?
  reference    String?
  receivedBy   User?              @relation("orderPaymentBy", fields: [receivedById], references: [id])
  receivedById String?
  receivedAt   DateTime           @default(now())

  @@index([orderId])
  @@index([shiftId])
  @@index([walletId, receivedAt])
}

// إشعار دفع بنكك يرفعه العميل (صورة + رقم العملية) — تراجعه المديرة (D-10)
model PaymentProof {
  id           String    @id @default(cuid())
  order        Order     @relation(fields: [orderId], references: [id])
  orderId      String
  // صورة خاصة (private/payments/…) — لا تُقدَّم علناً
  imageKey     String
  reference    String
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedBy   User?     @relation("proofReviewedBy", fields: [reviewedById], references: [id])
  reviewedById String?
  accepted     Boolean?
  reviewNote   String?

  @@index([orderId, createdAt])
}

// نمط تغليف (D-91): سعر خدمة بالجنيه + مواد مستهلكة تُخصم من المخزون عند التجهيز
model WrapStyle {
  id            String              @id @default(cuid())
  code          String              @unique
  nameAr        String
  nameEn        String
  descriptionAr String?
  descriptionEn String?
  priceSdg      Decimal             @default(0) @db.Decimal(18, 2)
  /// صورة النمط في صفحة إتمام الطلب وصفحة «صمّم هديتك» (مفتاح التخزين، D-98)
  imageKey      String?
  isActive      Boolean             @default(false)
  sortOrder     Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  materials     WrapStyleMaterial[]
  orders        Order[]
}

model WrapStyleMaterial {
  id          String         @id @default(cuid())
  wrapStyle   WrapStyle      @relation(fields: [wrapStyleId], references: [id], onDelete: Cascade)
  wrapStyleId String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  variantId   String
  qty         Decimal        @db.Decimal(12, 3)

  @@unique([wrapStyleId, variantId])
}

enum GiftPhotoDecision {
  APPROVED // وافق العميل
  CHANGES // طلب تعديلاً
  AUTO_APPROVED // لم يرد خلال ساعة
  STAFF_APPROVED // وصلت الموافقة على واتساب
}

// صورة الهدية قبل التسليم (D-13، D-91) — أُلغيت الميزة (D-99): الجدول باقٍ للسجلات القديمة فقط ولا يُكتب فيه
model GiftPhoto {
  id           String             @id @default(cuid())
  order        Order              @relation(fields: [orderId], references: [id])
  orderId      String
  imageKey     String
  uploadedBy   User?              @relation("giftPhotoBy", fields: [uploadedById], references: [id])
  uploadedById String?
  createdAt    DateTime           @default(now())
  decision     GiftPhotoDecision?
  decidedAt    DateTime?
  feedback     String?

  @@index([orderId, createdAt])
}

// مناسبة (D-92): قائمة تديرها المديرة؛ المنتج في أكثر من مناسبة. بانر الموسم يظهر بين تاريخين
model Occasion {
  id            String            @id @default(cuid())
  slug          String            @unique
  nameAr        String
  nameEn        String
  descriptionAr String?
  descriptionEn String?
  /// الأيقونة: صورة مربعة لدوائر «تسوّق حسب المناسبة»
  imageKey      String?
  /// الغلاف: صورة عريضة 2:1 لبطاقة الموسم وأعلى صفحة المناسبة (D-102)
  coverKey      String?
  isActive      Boolean           @default(true)
  sortOrder     Int               @default(0)
  // بانر الرئيسية: من بداية يوم البداية حتى نهاية يوم النهاية (بتوقيت الخرطوم)
  bannerStart   DateTime?
  bannerEnd     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  products      ProductOccasion[]

  @@index([isActive, sortOrder])
}

model ProductOccasion {
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  occasion   Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  occasionId String

  @@id([productId, occasionId])
  @@index([occasionId])
}

/// وجهة زر البانر (D-101)
enum BannerLink {
  PRODUCTS // كل المنتجات
  CATEGORY // قسم (linkTarget = slug)
  OCCASION // مناسبة (linkTarget = slug)
  PRODUCT // منتج (linkTarget = id)
  GIFT // صفحة «صمّم هديتك»
}

/// بانرات الرئيسية (D-101): حتى 3 تظهر بالترتيب، بصورة للكمبيوتر وأخرى اختيارية للجوال ومدة اختيارية
model Banner {
  id             String     @id @default(cuid())
  titleAr        String
  titleEn        String
  textAr         String?
  textEn         String?
  ctaAr          String
  ctaEn          String
  badgeAr        String?
  badgeEn        String?
  linkType       BannerLink @default(PRODUCTS)
  linkTarget     String?
  imageKey       String
  mobileImageKey String?
  /// أيام المحل (شاملة)؛ فارغ = بلا حد
  startsOn       DateTime?  @db.Date
  endsOn         DateTime?  @db.Date
  isActive       Boolean    @default(true)
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  @@index([isActive, deletedAt, sortOrder])
}

// ---------- الإشعارات (D-109) ----------
enum NotificationType {
  ORDER_NEW // طلب جديد من المتجر
  PAYMENT_PROOF // العميل رفع إشعار بنكك
  ORDER_ESCALATED // طلب لم يُفتح في المهلة
  BANKAK_EXPIRING // حجز بنكك يقترب من الانتهاء بلا دفع
  LOW_STOCK
  BATCH_EXPIRING
  PRICE_SUGGESTIONS
  DAILY_SUMMARY
  STOCK_ADJUSTMENT // تسوية مخزون بانتظار الاعتماد
  STOCK_ADJUSTED // اعتُمدت تسوية (للمالك) أو رُفضت (لمن سجّلتها)
  STOCK_COUNT // جرد أُرسل للمراجعة، أو موعد جرد (D-112)
  SECURITY_ALERT // محاولات دخول فاشلة متكررة (D-114)
}

enum NotificationPriority {
  URGENT
  IMPORTANT
  NORMAL
}

/// إشعار واحد لكل حدث، يصل لعدة مستخدمين (NotificationRecipient). النص بالعربي وقت الإنشاء.
model Notification {
  id        String               @id @default(cuid())
  type      NotificationType
  priority  NotificationPriority
  title     String
  body      String
  href      String
  order     Order?               @relation(fields: [orderId], references: [id])
  orderId   String?
  /// يمنع تكرار نفس الحدث (مثل «ORDER_NEW:<id>»)
  dedupeKey String?              @unique
  /// متى أُرسل لأجهزة الجوال (D-109) — فارغ = ينتظر الإرسال (Outbox)
  pushedAt  DateTime?
  createdAt DateTime             @default(now())

  recipients NotificationRecipient[]

  @@index([createdAt])
  @@index([pushedAt, createdAt])
  @@index([orderId])
}

model NotificationRecipient {
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  notificationId String
  user           User         @relation(fields: [userId], references: [id])
  userId         String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@id([notificationId, userId])
  @@index([userId, readAt, createdAt])
}

/// جهاز مفعّل لإشعارات الجوال (Web Push) — مفاتيح التشفير من المتصفح
model PushSubscription {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  /// «Chrome · أندرويد» للعرض في التفضيلات
  label      String
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

/// تفضيلات الإشعارات لكل مستخدمة؛ بلا سجل = الافتراضي (D-109)
model NotificationPreference {
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String             @id
  /// الأحداث التي تصل للجوال
  pushTypes     NotificationType[]
  /// ساعات الهدوء بتوقيت الخرطوم «HH:MM»؛ فارغ = بلا هدوء
  quietStart    String?
  quietEnd      String?
  /// العاجل يصل حتى في ساعات الهدوء
  urgentInQuiet Boolean            @default(true)
  updatedAt     DateTime           @updatedAt
}

/// تنبيهات المخزون المرسلة (D-109): «low:<variant>» يُحذف عند إعادة التعبئة فيُنبَّه من جديد لاحقاً،
/// «batch:<id>» دفعة نُبّه على اقتراب صلاحيتها (مرة واحدة)
model NotificationAlertState {
  key       String   @id
  createdAt DateTime @default(now())
}

// ---------- سجل التدقيق (D-114) ----------
// ما لا تسجّله جداوله أصلاً: تغيير الإعدادات، إدارة المستخدمين، هوامش الأقسام، تعديل المنتجات
// وأرشفتها، وتسجيل الدخول. باقي الأحداث (الأسعار، المخزون، المال، الطلبات…) تُقرأ من جداولها مباشرة.
// لا يُعدَّل ولا يُحذف
model AuditEvent {
  id        String   @id @default(cuid())
  // SETTINGS_UPDATED، USER_CREATED، USER_ROLE، USER_BANNED، USER_UNBANNED، USER_PASSWORD، CATEGORY_UPDATED،
  // PRODUCT_UPDATED، PRODUCT_ARCHIVED، LOGIN، LOGIN_FAILED
  type      String
  actor     User?    @relation("auditActor", fields: [actorId], references: [id])
  actorId   String?
  title     String
  detail    String?
  href      String?
  // قبل/بعد للإعدادات والهوامش
  changes   Json?
  sensitive Boolean  @default(false)
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([type, createdAt])
}
