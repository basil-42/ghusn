// مخطط قاعدة بيانات غصن — النسخة الأولى (المرحلة 0)
// كل مبلغ يُحفظ بعملته الأصلية + ما يعادله بالدولار (عملة الأساس)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- المستخدمون والأدوار ----------
// الجداول User/Session/Account/Verification بالشكل الذي يتوقعه Better Auth
// (مع إضافات phone-number وadmin). لا تُعدَّل أسماء حقولها دون مراجعة إعداد Better Auth.

enum Role {
  OWNER // المالك (باسل)
  MANAGER // المديرة
  STAFF // موظفة / كاشير
}

model User {
  id                  String    @id @default(cuid())
  name                String
  // Better Auth يشترط بريداً؛ لمن ليس لديها بريد يُولَّد بريد داخلي من رقم الهاتف
  email               String    @unique
  emailVerified       Boolean   @default(false)
  image               String?
  // رقم الهاتف بصيغة دولية موحدة E.164 (مثل +249912345678) — هو اسم الدخول
  phoneNumber         String?   @unique
  phoneNumberVerified Boolean   @default(false)
  role                Role      @default(STAFF)
  // إيقاف الحساب (بدل الحذف) — من إضافة admin
  banned              Boolean   @default(false)
  banReason           String?
  banExpires          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions        Session[]
  accounts        Account[]
  ratesEntered    ExchangeRate[]
  productsCreated Product[]
}

model Session {
  id             String   @id @default(cuid())
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

// طريقة الدخول؛ كلمة السر المشفّرة في providerId = "credential"
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------- العملات وأسعار الصرف ----------
model Currency {
  code     String  @id // SDG, USD, QAR, CNY, EGP
  nameAr   String
  nameEn   String
  symbol   String
  decimals Int     @default(2)
  isBase   Boolean @default(false) // الدولار = true
  isActive Boolean @default(true)

  ratesFrom ExchangeRate[] @relation("rateFrom")
  wallets   Wallet[]
}

enum RateSource {
  PARALLEL_MARKET // السوق الموازي
  BANK // سعر البنك
  ACTUAL_TRANSFER // من تحويل فعلي
  FIXED_PEG // سعر ثابت (الريال القطري)
}

// سعر الصرف: كم وحدة من العملة = 1 دولار
model ExchangeRate {
  id           String     @id @default(cuid())
  currency     Currency   @relation("rateFrom", fields: [currencyCode], references: [code])
  currencyCode String
  unitsPerUsd  Decimal    @db.Decimal(18, 6) // مثال: SDG 2500.000000
  source       RateSource @default(PARALLEL_MARKET)
  effectiveAt  DateTime   @default(now())
  note         String?
  enteredBy    User?      @relation(fields: [enteredById], references: [id])
  enteredById  String?
  createdAt    DateTime   @default(now())

  @@index([currencyCode, effectiveAt])
}

// ---------- المحافظ (أماكن المال) ----------
model Wallet {
  id           String   @id @default(cuid())
  name         String // صندوق المحل، بنكك، حساب باسل – قطر
  currency     Currency @relation(fields: [currencyCode], references: [code])
  currencyCode String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// ---------- الأقسام ----------
model Category {
  id           String  @id @default(cuid())
  slug         String  @unique
  nameAr       String
  nameEn       String
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)
  // هامش الربح المستهدف والحد الأدنى للتنبيه (نسبة من سعر البيع)
  targetMargin Decimal @default(0.40) @db.Decimal(5, 4)
  minMargin    Decimal @default(0.35) @db.Decimal(5, 4)

  products Product[]
}

// ---------- المنتجات ----------
enum ProductType {
  STOCK // بضاعة للبيع
  MATERIAL // مادة تغليف داخلية — لا تُباع ولا تظهر في المتجر
}

enum StockUnit {
  PIECE // حبة
  METER // متر (شرائط)
  SHEET // ورقة / فرخ
}

model Product {
  id            String      @id @default(cuid())
  nameAr        String
  nameEn        String?
  descriptionAr String?
  descriptionEn String?
  category      Category    @relation(fields: [categoryId], references: [id])
  categoryId    String
  type          ProductType @default(STOCK)
  unit          StockUnit   @default(PIECE)
  // تتبّع تاريخ الصلاحية للدفعات (عطور وتجميل — FEFO)
  trackExpiry   Boolean     @default(false)
  isActive      Boolean     @default(true)
  // يظهر في المتجر الإلكتروني (البضاعة فقط)
  isWebVisible  Boolean     @default(false)
  // نص البحث الموحّد (normalizeArabic): الأسماء + SKU + الباركودات + القسم
  searchText    String      @default("")
  createdBy     User?       @relation(fields: [createdById], references: [id])
  createdById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  variants ProductVariant[]

  @@index([categoryId])
  @@index([deletedAt])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

// المتغيّر = وحدة البيع والمخزون والباركود (مقاس / لون / حجم)
model ProductVariant {
  id        String    @id @default(cuid())
  product   Product   @relation(fields: [productId], references: [id])
  productId String
  sku       String    @unique
  barcode   String    @unique
  size      String? // المقاس
  color     String? // اللون
  volume    String? // الحجم (50ml)
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([productId])
}
