{
  "name": "ghusn",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @ghusn/db migrate",
    "db:seed": "pnpm --filter @ghusn/db seed",
    "db:studio": "pnpm --filter @ghusn/db studio"
  },
  "devDependencies": {
    "turbo": "2.11.5",
    "typescript": "5.9.3"
  }
}
