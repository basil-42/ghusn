# انسخ هذا الملف باسم .env  (الأمر: cp .env.example .env)
DATABASE_URL="postgresql://ghusn:ghusn_dev_password@localhost:5432/ghusn?schema=public"
APP_URL="http://localhost:3000"

# تسجيل الدخول (Better Auth). في الإنتاج: سرّ عشوائي طويل مختلف — openssl rand -base64 32
BETTER_AUTH_SECRET="dev-only-secret-change-me-in-production-000000"
BETTER_AUTH_URL="http://localhost:3000"

# مجلد الصور محلياً (الافتراضي apps/web/uploads). عند النشر: إعدادات R2 بدلاً منه
# UPLOAD_DIR="/var/ghusn/uploads"

# المهام الدورية (pg-boss) تعمل مع الخادم؛ 1 لإيقافها (مثلاً عند تشغيل أكثر من نسخة للاختبار)
# JOBS_DISABLED="1"

# قياس الزيارات (Umami على Coolify — D-108). فارغ = بلا قياس. يُقرأ عند التشغيل، لا يحتاج إعادة بناء
# UMAMI_SCRIPT_URL="https://stats.ghusn.store/script.js"
# UMAMI_WEBSITE_ID="00000000-0000-0000-0000-000000000000"
